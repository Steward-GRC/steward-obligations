# Local development settings. Copy to .env (git-ignored) and load it in the
# run target, for example with `dotenv: ['.env']` in the Taskfile.
#
# Local dev logs everything in human-readable form. Cluster environments set
# their own level and always log JSON: dev cluster debug, qa/staging info,
# production error.
LOG_LEVEL=trace
LOG_FORMAT=console

DATABASE_DSN=postgres://obligations:obligations@localhost:5432/obligations?sslmode=disable
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
CORE_GRPC_ADDR=localhost:9091
IDENTITY_GRPC_ADDR=localhost:9092
GRPC_PORT=9090
# Service-to-service authentication. Local runs have no cluster issuer, so it
# is switched off; obligations warns and reports itself degraded. In a cluster
# set WORKLOAD_OIDC_ISSUER and WORKLOAD_ALLOWED_SERVICEACCOUNTS instead (and
# WORKLOAD_TOKEN_FILE if the token isn't at /var/run/secrets/steward/token).
WORKLOAD_AUTH=disabled
PROBE_PORT=8080
RENDER_SIDECAR_URL=http://127.0.0.1:8091
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_STARTTLS=false
APP_ENV=dev
DEV_MAIL_CATCHALL_TO=dev@example.org
INTERNAL_BASE_URL=http://localhost:5173
REDIS_ADDR=
FCM_PROJECT_ID=
SCHEDULER_ENABLED=true
